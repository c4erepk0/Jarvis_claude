# ===== J.A.R.V.I.S. — настройки. Скопируйте в .env и заполните. =====

# --- Сервер дашборда ---
# 127.0.0.1 — только этот компьютер. Для доступа с телефона: 0.0.0.0 + код входа (или Tailscale, см. README).
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
# Код входа в дашборд. Обязателен, если JARVIS_HOST не localhost (и в Docker). Длинный и случайный.
JARVIS_ACCESS_CODE=
# Ключ подписи сессий; пусто — создастся сам в data/secret.key
JARVIS_SECRET=
JARVIS_DATA_DIR=data

# --- Память: хранилище Obsidian ---
# Папка хранилища. Пустая — Jarvis создаст стартовую структуру (vault-template).
# Пример для iCloud на Mac: ~/Library/Mobile Documents/iCloud~md~obsidian/Documents/Jarvis
VAULT_PATH=vault
VAULT_JARVIS_DIR=Jarvis
VAULT_PROJECTS_DIR=Projects
VAULT_FINANCE_DIR=Finance
VAULT_JOURNAL_DIR=Journal
VAULT_TASKS_FILE=Tasks/Inbox.md
# Как часто проверять изменения в заметках (сек) — от этого зависит «реальное время» на дашборде
VAULT_WATCH_INTERVAL=1.5

# --- Личность ---
USER_TITLE=сэр
USER_NAME=
TIMEZONE=Europe/Moscow
CURRENCY=RUB

# --- Мозг: Claude API (https://console.anthropic.com) ---
# Без ключа Jarvis работает на командах (задачи, траты, протоколы), с ключом — понимает свободную речь,
# ищет в интернете и разбирает фото чеков.
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-opus-5-5
# low — быстрее отвечает голосом; medium / high — глубже думает (дороже и медленнее)
JARVIS_EFFORT=low
JARVIS_WEB_SEARCH=1
# Простые команды выполнять сразу, без Claude (быстро и бесплатно)
JARVIS_LOCAL_FIRST=1
JARVIS_MAX_TURNS=40

# --- Голос ---
# edge — бесплатные нейроголоса Microsoft (нужен интернет); piper — полностью локально; browser — голос телефона
TTS_ENGINE=edge
# ru-RU-DmitryNeural — спокойный мужской русский; en-US-BrianMultilingualNeural — русский с английским акцентом;
# en-GB-RyanNeural — британский английский (для ответов на английском)
TTS_VOICE=ru-RU-DmitryNeural
TTS_RATE=-4%
TTS_PITCH=-8Hz
PIPER_BIN=piper
PIPER_MODEL=
WAKE_WORD=джарвис

# --- Погода и брифинг ---
WEATHER_CITY=Москва
WEATHER_LAT=55.7558
WEATHER_LON=37.6173
# Во сколько присылать утренний брифинг в Telegram (пусто — не присылать)
BRIEFING_TIME=08:30

# --- Проекты ---
# Fine-grained токен GitHub: Contents (read), Issues (read/write), Actions (read/write), Metadata (read)
# на нужные репозитории. Нужен для приватных репозиториев, задач для @claude и деплоя.
GITHUB_TOKEN=
# Claude Code на этом компьютере (режим «поручить локально»)
CLAUDE_CODE_BIN=claude
CLAUDE_CODE_PERMISSION_MODE=acceptEdits
# Пусто — набор по умолчанию: правка файлов, git без push, тесты
CLAUDE_CODE_ALLOWED_TOOLS=
CI_CHECK_MINUTES=5
# Токен метрик IPAStore (тот же, что JARVIS_TOKEN в .env IPAStore); имя переменной задаётся в заметке проекта
IPASTORE_JARVIS_TOKEN=

# --- Telegram: оповещения и команды с телефона (отдельный бот от @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_VOICE_REPLY=0

# --- Диагностика: пороги тревоги, % ---
DIAG_CPU_ALERT=90
DIAG_RAM_ALERT=90
DIAG_DISK_ALERT=90

# --- Синхронизация Obsidian (Docker-профили, см. docs/sync.md) ---
# Self-hosted LiveSync: CouchDB + мост livesync-bridge  →  docker compose --profile livesync up -d
COUCHDB_USER=jarvis
COUCHDB_PASSWORD=
LIVESYNC_DB=jarvis
# Пароль сквозного шифрования из настроек плагина LiveSync (пусто — без шифрования)
LIVESYNC_PASSPHRASE=
# 1 — если в плагине включено «Obfuscate paths»
LIVESYNC_OBFUSCATE=0
